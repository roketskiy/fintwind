#!/bin/sh

# Leave Git-generated merge, revert, and autosquash subjects intact.
if git rev-parse --verify -q MERGE_HEAD >/dev/null; then
    exit 0
fi

message=$(git stripspace --strip-comments < "$1") || exit 1
subject=$(printf '%s\n' "$message" | sed -n '1p')
case "$subject" in
    'Revert "'*'"'|'fixup! '?*|'squash! '?*|'amend! '?*) exit 0 ;;
esac

if printf '%s\n' "$subject" | LC_ALL=C grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9]+([./_-][a-z0-9]+)*\))?!?: [^[:space:]]'; then
    exit 0
fi

printf '%s\n' \
    'Invalid commit subject. Use type(scope): description (scope is optional).' \
    'Example: fix(chat): 修复消息分组' \
    'Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert.' >&2
exit 1
