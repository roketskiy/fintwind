# Apply only after the independent Pages origin has passed public E2E.
# The relay origin deliberately serves no HTML, WASM, or Service Worker.
# Verified 2026-10-09 against https://www.cloudflare.com/ips-v4 and ips-v6.
# Refresh the official ranges before changing this candidate in production.
{
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP
    }
}

relay.fintwind.xyz {
    tls /etc/ssl/fintwind/origin-cert.pem /etc/ssl/fintwind/origin-key.pem

    @api path /api/* /ws
    handle @api {
        reverse_proxy 127.0.0.1:8090 {
            # One normalized IP, derived only from a trusted Cloudflare peer.
            # Direct clients cannot replace it with incoming proxy headers.
            header_up X-Forwarded-For {client_ip}
            header_up -CF-Connecting-IP
            header_up -X-Real-IP
        }
    }

    # An old service worker requesting an update receives a terminal response;
    # existing browser site data still requires explicit cleanup on migration.
    @worker path /sw.js /workbox-*.js
    handle @worker {
        header Cache-Control "no-store"
        respond "" 410
    }

    handle {
        header Cache-Control "no-store"
        respond "" 404
    }

    header {
        Strict-Transport-Security "max-age=31536000; include-subdomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }
}
