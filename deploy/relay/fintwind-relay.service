# fintwind-relay systemd unit — install as
# /etc/systemd/system/fintwind-relay.service, then:
#   useradd --system --home /var/lib/fintwind-relay --shell /usr/sbin/nologin fintwind-relay
#   mkdir -p /var/lib/fintwind-relay && chown fintwind-relay:fintwind-relay /var/lib/fintwind-relay
#   cp target/release/fintwind-relay /usr/local/bin/ && chown root:root /usr/local/bin/fintwind-relay
#   systemctl daemon-reload && systemctl enable --now fintwind-relay
#
# The relay binds loopback only; Caddy fronts it. The service account has
# no shell and owns only its data directory — the deployment checklist's
# "least privilege" row, made concrete.

[Unit]
Description=Fintwind remote-control relay
After=network-online.target
Wants=network-online.target

[Service]
User=fintwind-relay
Group=fintwind-relay
ExecStart=/usr/local/bin/fintwind-relay --bind 127.0.0.1:8090 --db /var/lib/fintwind-relay/relay.sqlite3
Environment=RUST_LOG=info
# The relay never handles signals itself; a stop is a kill, which is safe
# because the store runs in WAL mode and queues are in-memory by design.
KillMode=process
Restart=on-failure
RestartSec=5

# Hardening: the relay needs its data directory, loopback sockets, and
# nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/fintwind-relay
RestrictAddressFamilies=AF_INET AF_INET6
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
