{$FINTWIND_MOBILE_DOMAIN} {
    encode zstd gzip
    log {
        output discard
    }
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; connect-src 'self' wss://{$FINTWIND_MOBILE_DOMAIN}; img-src 'self' data: blob:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        -Server
    }
    @uncached not path /assets/*
    header @uncached Cache-Control "no-store"
    @relay path /agent /c/* /v1/admission/*
    handle @relay {
        reverse_proxy 127.0.0.1:8789 {
            header_up X-Forwarded-For {http.request.remote.host}
            flush_interval -1
        }
    }
    handle {
        root * /var/www/fintwind-mobile
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
}
